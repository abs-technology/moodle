# Copied to terraform/deployments/<name>/terraform.tfvars by `make new`.
# Gitignored. Fill the required block; everything else has a default.

# --- identity (required, unique in the AWS account) ---
name = "school-b-aws"

# --- credentials (or set profile / AWS_* env instead) ---
access_key = "AKIA..."
secret_key = "..."
# profile    = "school-b"

# --- placement ---
region = "ap-southeast-1"
# Local Zone: opt the zone group in first; no t3 family.
# availability_zone = "ap-southeast-1-han-1a"
# instance_type     = "c7i.large"
# vpc_cidr    = "10.21.0.0/16"
# subnet_cidr = "10.21.1.0/24"

# --- access ---
ssh_allowed_cidrs = ["0.0.0.0/0"]

# --- site ---
acme_email = "admin@example.com"
# Empty = moodle.<elastic-ip>.nip.io. Do not set this to move a live site.
# moodle_domain = "lms.example.com"
# acme_staging  = true

# --- snapshots (already on: Sunday 22:00 Asia/Ho_Chi_Minh, keep 24) ---
# timezone              = "Asia/Ho_Chi_Minh"
# snapshot_weekly       = true
# snapshot_retain_weeks = 24

# --- protection (already on). Set false, apply, then destroy. ---
# vm_deletion_protection = true
