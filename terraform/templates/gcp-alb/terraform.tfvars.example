# Copied to terraform/deployments/<name>-gcp/terraform.tfvars by `make create gcp-alb`.
# Gitignored. Then: make apply-alb <name>

# --- identity (required, unique in the GCP project) ---
name = "school-b-gcp"

# --- project ---
project_id = "my-gcp-project"
# Optional GCS state bucket. Empty = absi-moodle-tfstate-<deployment>.
# tf_state_bucket = "absi-moodle-tfstate-school-b-gcp"
# credentials = "/path/to/sa-key.json"

# --- placement ---
region = "asia-southeast1"
zone   = "asia-southeast1-a"
os     = "debian-13" # debian-13 | debian-12 | ubuntu-24.04 (first boot only)

# --- access (SSH is IAP: make ssh-alb) ---
ssh_allowed_cidrs = ["0.0.0.0/0"]

# --- site ---
# Used as the Moodle admin email. TLS is Certificate Manager, not Let's Encrypt.
acme_email = "admin@example.com"
# Empty = moodle.<global-ip>.nip.io. Do not set this to move a live site.
# moodle_domain = "lms.example.com"
# enable_apis   = false

# --- snapshots (already on: Sunday 22:00 Asia/Ho_Chi_Minh, keep 24) ---
# timezone              = "Asia/Ho_Chi_Minh"
# snapshot_weekly       = true
# snapshot_retain_weeks = 24

# --- protection (already on). Set false, apply-alb, then destroy. ---
# vm_deletion_protection = true
