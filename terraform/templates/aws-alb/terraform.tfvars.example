# Copied to terraform/deployments/<name>-aws/terraform.tfvars by `make create aws-alb`.
# Gitignored. Then: make apply aws-alb <name>

# --- identity (required, unique in the AWS account) ---
name = "school-b-aws"

# --- credentials (or set profile / AWS_* env instead) ---
access_key = "AKIA..."
secret_key = "..."
# profile    = "school-b"

# --- placement (regional AZs only — not Local Zone) ---
region = "ap-southeast-1"
# instance_type = "t3.medium"
# vpc_cidr    = "10.21.0.0/16"
# subnet_cidr = "10.21.1.0/24"

# --- access (SSH is SSM: make ssh aws-alb <name>) ---
ssh_allowed_cidrs = ["0.0.0.0/0"]

# --- site ---
# Used as the Moodle admin email. TLS is ACM on the ALB, not Let's Encrypt.
acme_email = "admin@example.com"
# Empty = moodle.<anycast-ip>.nip.io. ACM cannot issue that name; the VM
# completes Let's Encrypt HTTP-01 and imports it (a few minutes after boot).
# Own cert: set moodle_domain and route53_zone_id or acm_certificate_arn
# before the first apply. Do not set moodle_domain to move a live site.
# moodle_domain       = "lms.example.com"
# route53_zone_id     = "Z0123456789ABCDEFGHIJ"
# acm_certificate_arn = "arn:aws:acm:ap-southeast-1:123456789012:certificate/..."

# --- snapshots (already on: Sunday 22:00 Asia/Ho_Chi_Minh, keep 24) ---
# timezone              = "Asia/Ho_Chi_Minh"
# snapshot_weekly       = true
# snapshot_retain_weeks = 24

# --- protection (already on). Set false, apply, then destroy. ---
# vm_deletion_protection = true
