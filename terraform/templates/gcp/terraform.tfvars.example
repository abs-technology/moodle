# Copied to terraform/deployments/<name>/terraform.tfvars by `make new`.
# Gitignored. Fill the required block; everything else has a default.

# --- identity (required, unique in the GCP project) ---
name = "school-b-gcp"

# --- project ---
project_id = "my-gcp-project"
# credentials = "/path/to/sa-key.json"

# --- placement ---
region = "asia-southeast1"
zone   = "asia-southeast1-a"

# --- access ---
# Setting this disables OS Login; SSH uses break-glass.pem.
ssh_allowed_cidrs = ["0.0.0.0/0"]

# --- site ---
acme_email = "admin@example.com"
# Empty = moodle.<static-ip>.nip.io. Do not set this to move a live site.
# moodle_domain = "lms.example.com"
# acme_staging  = true
# enable_apis   = false

# --- snapshots (already on: Sunday 22:00 Asia/Ho_Chi_Minh, keep 24) ---
# timezone              = "Asia/Ho_Chi_Minh"
# snapshot_weekly       = true
# snapshot_retain_weeks = 24

# --- protection (already on). Set false, apply, then destroy. ---
# vm_deletion_protection = true
