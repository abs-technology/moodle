# Moodle Data Directories
# Ignore contents but keep directory structure
data/moodle/*
data/moodledata/*
# Keep directory structure with .gitkeep files
!data/moodle/.gitkeep
!data/moodledata/.gitkeep

# Same layout under the deployment examples, created on first boot
examples/*/data/

# Environment file with sensitive information
.env

# Credentials — SSH keys, TLS keys, certificates
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*

# Terraform — state holds the generated Moodle/MariaDB passwords in plaintext.
# .terraform.lock.hcl is intentionally tracked.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
terraform/*/terraform.tfvars

# Docker volumes data
volumes/

# Backup files
*.sql
*.tar.gz
*.zip
backup/

# Log files
*.log
logs/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE / AI-editor — never track in this product repo
.cursor/
.vscode/
.idea/
agent-transcripts/
*.swp
*.swo
*~

# Temporary files
tmp/
temp/
*.tmp
