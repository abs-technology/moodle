# Recorded for change-domain.sh. Not written into config.php on apply-ip —
# Moodle follows the request Host until you move to a domain.
MOODLE_DOMAIN=203.0.113.10

# Unused until change-domain.sh enables Traefik. le = Let's Encrypt.
TLS_CERTRESOLVER=

ACME_EMAIL=admin@example.com
TRAEFIK_HTTP3=true

MOODLE_USERNAME=admin
MOODLE_PASSWORD=ChangeMe#2026
MOODLE_EMAIL=admin@example.com
MOODLE_SITE_NAME=ABS Technology Moodle LMS

MARIADB_ROOT_PASSWORD=ChangeMeRoot#2026
MARIADB_USER=moodle
MARIADB_PASSWORD=ChangeMeDb#2026
MARIADB_DATABASE=moodle

# PHP / Moodle upload limits (applied every container start).
PHP_MEMORY_LIMIT=512M
PHP_MAX_INPUT_VARS=5000
PHP_MAX_FILE_UPLOADS=200
PHP_POST_MAX_SIZE=2G
PHP_UPLOAD_MAX_FILESIZE=2G
PHP_MAX_EXECUTION_TIME=600
