# Public hostname. Also becomes Moodle's $CFG->wwwroot.
MOODLE_DOMAIN=lms.example.com

# le = Let's Encrypt; empty = serve certs/cert.pem via dynamic/tls.yml
TLS_CERTRESOLVER=le

# Needs a real public TLD; Let's Encrypt rejects .test and friends.
ACME_EMAIL=admin@example.com

# Staging CA: untrusted certs, no production rate limit.
# ACME_CASERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# HTTP/3 on UDP 443. Set false if UDP 443 cannot be opened to this host.
TRAEFIK_HTTP3=true

# Moodle admin account created on first boot.
MOODLE_USERNAME=admin
MOODLE_PASSWORD=ChangeMe#2026
MOODLE_EMAIL=admin@example.com
MOODLE_SITE_NAME=ABS Technology Moodle LMS

# Database.
MARIADB_ROOT_PASSWORD=ChangeMeRoot#2026
MARIADB_USER=moodle
MARIADB_PASSWORD=ChangeMeDb#2026
MARIADB_DATABASE=moodle

# PHP / Moodle upload limits (applied every container start).
PHP_MEMORY_LIMIT=512M
PHP_MAX_INPUT_VARS=5000
PHP_MAX_FILE_UPLOADS=200
PHP_POST_MAX_SIZE=4G
PHP_UPLOAD_MAX_FILESIZE=4G
PHP_MAX_EXECUTION_TIME=600
