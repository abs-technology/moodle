# Public hostname Traefik routes and Moodle uses as $CFG->wwwroot.
# For a throwaway test you can point any IP at nip.io, e.g. 45.57.137.2.nip.io
MOODLE_DOMAIN=lms.example.com

# Where the certificate comes from:
#   le      Traefik obtains and renews it from Let's Encrypt over HTTP-01
#   empty   Traefik serves certs/cert.pem via dynamic/tls.yml
TLS_CERTRESOLVER=le

# Only read when TLS_CERTRESOLVER=le. Needs a real public TLD — Let's Encrypt
# rejects reserved suffixes such as .test with "contact email has invalid domain".
ACME_EMAIL=admin@example.com

# Uncomment while testing: the staging CA issues untrusted certificates but does
# not consume the production rate limit, which shared domains exhaust quickly.
# ACME_CASERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Moodle admin account created on first boot.
MOODLE_USERNAME=absi_admin
MOODLE_PASSWORD=ChangeMe#2026
MOODLE_EMAIL=admin@example.com
MOODLE_SITE_NAME=ABS Technology Moodle LMS

# Database.
MARIADB_ROOT_PASSWORD=ChangeMeRoot#2026
MARIADB_USER=moodle
MARIADB_PASSWORD=ChangeMeDb#2026
MARIADB_DATABASE=moodle
