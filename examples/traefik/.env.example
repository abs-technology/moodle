# Public hostname Traefik routes and Moodle uses as $CFG->wwwroot.
# For a throwaway test you can point any IP at nip.io, e.g. 45.57.137.2.nip.io
MOODLE_DOMAIN=lms.example.com

# Only used by docker-compose.letsencrypt.yml.
ACME_EMAIL=admin@example.com

# Moodle admin account created on first boot.
MOODLE_USERNAME=absi_admin
MOODLE_PASSWORD=ChangeMe#2026
MOODLE_EMAIL=admin@example.com
MOODLE_SITE_NAME=ABS Technology Moodle LMS

# Database.
MARIADB_ROOT_PASSWORD=ChangeMeRoot#2026
MARIADB_USER=moodle
MARIADB_PASSWORD=ChangeMeDb#2026
MARIADB_DATABASE=moodle
